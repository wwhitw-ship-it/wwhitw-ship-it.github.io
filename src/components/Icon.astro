---
// 底部導覽列的圖示（筆記本、月曆、人像）
interface Props { name: 'notebook' | 'calendar' | 'person' | 'tag' }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 32 32" aria-hidden="true">
  {name === 'notebook' && <>
    <rect x="5" y="5" width="22" height="22" rx="2.5" fill="currentColor" />
    <rect x="5" y="5" width="22" height="6" rx="2.5" fill="currentColor" class="shade" />
    <path d="M9 15.5h14M9 19h14M9 22.5h14" stroke="var(--icon-line)" stroke-width="1.4" stroke-linecap="round" />
  </>}
  {name === 'calendar' && <>
    <rect x="5" y="6" width="22" height="21" rx="2.5" fill="currentColor" />
    <rect x="5" y="6" width="22" height="6" rx="2.5" fill="currentColor" class="shade" />
    <g fill="var(--icon-line)">
      {[0,1,2,3,4].flatMap((c) => [0,1,2].map((r) => <circle cx={9.5 + c * 3.25} cy={16 + r * 3.6} r="1.05" />))}
    </g>
  </>}
  {name === 'person' && <>
    <circle cx="16" cy="11" r="5.5" fill="currentColor" />
    <path d="M6 27c0-5.5 4.5-9 10-9s10 3.5 10 9z" fill="currentColor" />
  </>}
  {name === 'tag' && <>
    <path d="M5 7v8.5L17 27.5 27.5 17 15.5 5H7a2 2 0 0 0-2 2z" fill="currentColor" />
    <circle cx="11" cy="11" r="2" fill="var(--icon-line)" />
  </>}
</svg>
