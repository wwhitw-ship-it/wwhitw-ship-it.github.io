---
import { url } from '../site.config';
import { formatDate, readingTime, type Post } from '../lib';
interface Props { post: Post }
const { post } = Astro.props;
---
<article class="card">
  <a class="card-link" href={url(`posts/${post.id}/`)}>
    <h2>{post.data.title}{post.data.draft && <span class="badge">草稿</span>}</h2>
  </a>
  <p class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    · {readingTime(post.body)} 分鐘閱讀
  </p>
  {post.data.description && <p class="excerpt">{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <ul class="tags">
      {post.data.tags.map((t) => <li><a href={url(`tags/${encodeURIComponent(t)}/`)}>#{t}</a></li>)}
    </ul>
  )}
</article>
