---
import Base from '../../layouts/Base.astro';
import { url } from '../../site.config';
import { getPosts } from '../../lib';
const counts = new Map<string, number>();
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1]);
---
<Base title="標籤">
  <h1>標籤</h1>
  {tags.length === 0 ? <p class="empty">目前沒有標籤。</p> :
    <ul class="tags big">
      {tags.map(([t, n]) => <li><a href={url(`tags/${encodeURIComponent(t)}/`)}>#{t} <small>{n}</small></a></li>)}
    </ul>}
</Base>
