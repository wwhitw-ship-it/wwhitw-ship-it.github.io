---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, type Post } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<Base title={tag}>
  <section class="hero small"><h1><span>{tag}</span><em>{posts.length} posts</em></h1></section>
  <ul class="rows">{posts.map((post) => <PostRow post={post} />)}</ul>
</Base>
